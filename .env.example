# Copy to /etc/finance/.env on the server (root:finance, mode 640)
NODE_ENV=production
PORT=3000
# Unix socket connection — no TCP, no password
DATABASE_URL=postgresql:///finance?host=/var/run/postgresql
# Generate with: openssl rand -hex 32
SESSION_SECRET=<strong-random-secret>
# Optional — can be set during first-run onboarding or in Settings
ANTHROPIC_API_KEY=
# Model IDs are swappable without a code change; verify against
# https://docs.anthropic.com/en/docs/about-claude/models at deploy time.
# Overridable in-app via Settings.
AI_MODEL_CATEGORISATION=claude-haiku-4-5-20251001
AI_MODEL_ANALYSIS=claude-opus-5
TZ=Australia/Sydney
